# Supabase (obtenha em https://app.supabase.com → Project Settings → API)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key-publica




# API (opcional: para dev local com vercel dev, deixe vazio para same-origin)
# VITE_API_URL=

# ===== Variáveis para a API (Vercel Serverless) - NÃO usar no frontend =====
# Configure em Vercel → Settings → Environment Variables

# Mercado Pago (obtenha em https://www.mercadopago.com.br/developers/panel/app)
# MP_ACCESS_TOKEN=APP_USR-xxx

# Supabase (URL e Service Role para o backend)
# SUPABASE_URL=https://seu-projeto.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key
# SUPABASE_ANON_KEY=sua-anon-key  (opcional, se API já tiver SUPABASE_URL)
