{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "nada-normal-storefront-local",
  "account_id": "8f6b63890cf677004b89b130cba0dbf6",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "assets": {
    "directory": "../../dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*", "/health"]
  },
  "vars": {
    "APP_ENV": "local",
    "SHOP_API_ENABLED": "false",
    "RESERVATION_PROCESSOR_ENABLED": "false",
    "SUPABASE_URL": "",
    "SUPABASE_PUBLISHABLE_KEY": ""
  },
  "env": {
    "staging": {
      "name": "nada-normal-storefront-staging",
      "workers_dev": true,
      "preview_urls": false,
      "assets": {
        "directory": "../../dist", "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api", "/api/*", "/health"]
      },
      "secrets": { "required": ["SUPABASE_SECRET_KEY", "RESERVATION_PROCESSOR_SECRET"] },
      "vars": {
        "APP_ENV": "staging",
        "SHOP_API_ENABLED": "true",
        "CHECKOUT_PRO_ENABLED": "false",
        "CHECKOUT_PRO_MODE": "sandbox",
        "MP_PUBLIC_KEY": "APP_USR-0b533487-ad9f-4133-8199-5e900694880b",
        "PAYMENTS_API_URL": "https://pagamentos-staging.nadanormalclub.com.br",
        "RESERVATION_PROCESSOR_ENABLED": "false",
        "SUPABASE_URL": "https://bcemyxasbcwcrbinfguu.supabase.co",
        "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_HWo2KFFmedy4nsd5eTp9_g_RJUwOPr5"
      }
    },
    "production": {
      "name": "nada-normal-storefront-production",
      "workers_dev": false,
      "preview_urls": false,
      "assets": {
        "directory": "../../dist", "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api", "/api/*", "/health"]
      },
      "vars": {
        "APP_ENV": "production",
        "SHOP_API_ENABLED": "false",
        "RESERVATION_PROCESSOR_ENABLED": "false",
        "SUPABASE_URL": "",
        "SUPABASE_PUBLISHABLE_KEY": ""
      }
    }
  }
}
